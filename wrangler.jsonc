{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/wrangler-config-schema.json",
  "name": "c-store",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "c-store",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID"
    }
  ]
}
